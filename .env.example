# Copy to .env and fill in.

# MongoDB — local instance or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=task_inbox

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Optional extra restriction on top of account linking: if set, only these
# Telegram chat ids may talk to the bot at all. Usually left empty.
TELEGRAM_ALLOWED_CHAT_IDS=

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low keeps extraction fast and cheap; raise if classifications feel sloppy
ANTHROPIC_EFFORT=low

# IANA timezone used to resolve "tomorrow"/"by Friday"
TIMEZONE=Asia/Kolkata

PORT=3200
# 0.0.0.0 = reachable from other devices on your network. 127.0.0.1 = this machine only.
HOST=0.0.0.0

# Set to true ONLY when running behind a reverse proxy (Caddy, nginx, a PaaS
# router) so Express reads the real client IP and protocol from X-Forwarded-*.
# Leaving it on while directly exposed lets clients spoof those headers.
TRUST_PROXY=false

# Open registration. Leave true to create your accounts, then set to false so
# strangers who find the URL cannot sign themselves up.
ALLOW_SIGNUP=true
# error | warn | info | debug
LOG_LEVEL=info

# --- Voice notes -----------------------------------------------------------
# The Claude API takes text and images but not audio, so forwarded voice notes
# need a speech-to-text service. Any OpenAI-compatible /audio/transcriptions
# endpoint works, including a local whisper.cpp server. Leave TRANSCRIBE_URL
# empty and voice notes are politely refused; everything else still works.
TRANSCRIBE_URL=
TRANSCRIBE_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_TIMEOUT_MS=120000

# Largest forwarded photo to download and keep, in bytes.
MAX_IMAGE_BYTES=1500000

# How often the scheduler checks for digests and deadline nudges.
SCHEDULER_INTERVAL_MS=60000
