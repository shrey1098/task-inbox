# Copy to .env and fill in.

# MongoDB — local instance or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=task_inbox

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated chat ids allowed to use the bot.
# Leave empty to auto-pin to the first chat that messages the bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low keeps extraction fast and cheap; raise if classifications feel sloppy
ANTHROPIC_EFFORT=low

# IANA timezone used to resolve "tomorrow"/"by Friday"
TIMEZONE=Asia/Kolkata

PORT=3200
# 0.0.0.0 = reachable from your phone on the same network. 127.0.0.1 = this machine only.
HOST=0.0.0.0
# error | warn | info | debug
LOG_LEVEL=info
